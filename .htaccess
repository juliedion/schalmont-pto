Options -MultiViews
RewriteEngine On

# Force browsers to always re-check with the server before using a cached
# copy of a page or script. Without this, browsers can keep showing an old
# version of a page (or the back office) for a long time after we deploy an
# update, even though the new version is already live on the server.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Chocolate Bar Fundraiser now runs through Zeffy, not its own page
RewriteRule ^chocolate(\.html)?/?$ https://www.zeffy.com/en-US/ticketing/gertrude-hawk-chocolate-bar-fundraiser-schalmont-pto [R=301,L]

# Redirect old casino-night URL to casinoroyale
RewriteRule ^casino-night$ /casinoroyale [R=301,L]

# Redirect old class-of-YYYY URLs to classofYYYY
RewriteRule ^class-of-([0-9]{4})$ /classof$1 [R=301,L]

# Singular /yearbook -> the yearbooks hub page
RewriteRule ^yearbook/?$ /yearbooks [R=301,L]

# Back-office published pages, e.g. /ms/spring-concert  or  /jes/fun-run
RewriteRule ^(woestina|jes|ms|hs|pto)/([A-Za-z0-9_-]+)/?$ p.html?prefix=$1&slug=$2 [L,QSA]
RewriteRule ^p/([A-Za-z0-9_-]+)/?$ p.html?slug=$1 [L,QSA]

# Trail of Treats -- the real page's address is /pto/trail-of-treats (its actual slug),
# but the flyer's printed URL and a couple of other spellings have been used to refer to
# it, so alias all of them straight to the real page.
RewriteRule ^haunted-trail/?$ /pto/trail-of-treats [R=301,L]
RewriteRule ^trailoftreats/?$ /pto/trail-of-treats [R=301,L]
RewriteRule ^pto/trailoftreats/?$ /pto/trail-of-treats [R=301,L]

# Redirect /index and /index.html to /
RewriteCond %{THE_REQUEST} \s/+index(\.html)?\s [NC]
RewriteRule ^ / [R=301,L]

# Redirect any request for /page.html to /page (permanent, for SEO)
RewriteCond %{THE_REQUEST} \s/(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Internally serve /page as /page.html (no redirect loop)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
