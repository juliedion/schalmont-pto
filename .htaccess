Options -MultiViews
RewriteEngine On

# Force browsers to always re-check with the server before using a cached
# copy of a page or script. Without this, browsers can keep showing an old
# version of a page (or the back office) for a long time after we deploy an
# update, even though the new version is already live on the server.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Chocolate Bar Fundraiser now runs through Zeffy, not its own page
RewriteRule ^chocolate(\.html)?/?$ https://www.zeffy.com/en-US/ticketing/gertrude-hawk-chocolate-bar-fundraiser-schalmont-pto [R=301,L]

# Redirect old casino-night URL to casinoroyale
RewriteRule ^casino-night$ /casinoroyale [R=301,L]

# Redirect old class-of-YYYY URLs to classofYYYY
RewriteRule ^class-of-([0-9]{4})$ /classof$1 [R=301,L]

# Singular /yearbook -> the yearbooks hub page
RewriteRule ^yearbook/?$ /yearbooks [R=301,L]

# Old /jes/... links (Jefferson's prefix before it was renamed to the full word) --
# redirect to the new address rather than 404 any flyer/QR code already printed with it.
RewriteRule ^jes/([A-Za-z0-9_-]+)/?$ /jefferson/$1 [R=301,L]

# Trail of Treats -- the real page's address is now /trailoftreats (an all-district
# page, no school prefix). Both the flyer's printed URL and the page's old /pto/...
# address (from before it became an all-district page) still get used, so alias them
# straight to the real page. Must come before the back-office rule below, which would
# otherwise swallow /pto/trail-of-treats itself. (Do NOT alias plain /trailoftreats here
# -- that IS the real page's own address now, and self-redirecting it caused an
# infinite redirect loop.)
RewriteRule ^haunted-trail/?$ /trailoftreats [R=301,L]
RewriteRule ^pto/trail-of-treats/?$ /trailoftreats [R=301,L]

# Back-office published pages, e.g. /ms/spring-concert  or  /jefferson/fun-run
RewriteRule ^(woestina|jefferson|ms|hs|pto)/([A-Za-z0-9_-]+)/?$ p.html?prefix=$1&slug=$2 [L,QSA]
RewriteRule ^p/([A-Za-z0-9_-]+)/?$ p.html?slug=$1 [L,QSA]

# Sign-up sheets with a custom URL, e.g. /signup/candy-monsters
RewriteRule ^signup/([A-Za-z0-9_-]+)/?$ signup.html?slug=$1 [L,QSA]

# Redirect /index and /index.html to /
RewriteCond %{THE_REQUEST} \s/+index(\.html)?\s [NC]
RewriteRule ^ / [R=301,L]

# Redirect any request for /page.html to /page (permanent, for SEO)
RewriteCond %{THE_REQUEST} \s/(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Internally serve /page as /page.html (no redirect loop)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Anything else that's a single clean segment and isn't a real file/page above falls
# through to a back-office page with no school attached -- those publish with no
# prefix at all, e.g. schalmontpto.com/some-event instead of schalmontpto.com/pto/....
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html !-f
RewriteRule ^([A-Za-z0-9_-]+)/?$ p.html?slug=$1 [L,QSA]
