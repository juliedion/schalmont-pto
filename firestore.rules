rules_version = '2';

/* ============================================================
   Schalmont PTO — Firestore security rules
   ------------------------------------------------------------
   HOW TO INSTALL:
     1. Go to  https://console.firebase.google.com  → project "schalmont-pto"
     2. Left menu → Build → Firestore Database → "Rules" tab
     3. Select ALL the text in the box and delete it
     4. Paste this whole file
     5. Press "Publish"
   ============================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---- helpers ---- */
    function signedIn() { return request.auth != null; }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isOwner() {
      return signedIn() && (
        request.auth.token.email == 'julie@schalmontpto.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         userData().role == 'superadmin')
      );
    }
    function adminSchools() {
      return (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              userData().role == 'admin')
        ? userData().adminSchools : [];
    }
    function canManage(school) {
      return isOwner() || (school in adminSchools());
    }
    // A page may belong to several schools. Old docs only have `school`.
    function pageSchoolList(d) {
      return ('schools' in d && d.schools is list && d.schools.size() > 0)
        ? d.schools
        : (('school' in d && d.school != null) ? [d.school] : []);
    }
    // true only if EVERY school in the list is one the caller manages
    function canManageAllOf(list) {
      return isOwner() || (list.size() > 0 && list.hasOnly(adminSchools()));
    }
    // true if the caller manages AT LEAST ONE school in the list
    function canManageAnyOf(list) {
      return isOwner() || list.hasAny(adminSchools());
    }
    function isAnyAdmin() {
      return isOwner() || (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userData().role in ['admin', 'superadmin']
      );
    }

    /* ---- Back office: pages (may be shared by several schools) ---- */
    match /pages/{pageId} {
      allow read: if resource.data.status == 'published'
                  || (signedIn() && canManageAnyOf(pageSchoolList(resource.data)));
      allow create: if signedIn()
                  && canManageAllOf(pageSchoolList(request.resource.data));
      // You may edit a page if you manage at least one of its schools, as long as
      // you don't add or remove any school you don't manage yourself.
      allow update: if signedIn()
                  && canManageAnyOf(pageSchoolList(resource.data))
                  && (isOwner() ||
                      pageSchoolList(request.resource.data).toSet().difference(adminSchools().toSet())
                      == pageSchoolList(resource.data).toSet().difference(adminSchools().toSet()));
      allow delete: if signedIn() && canManageAllOf(pageSchoolList(resource.data));
    }

    /* ---- Back office: uploaded files/photos metadata ---- */
    match /assets/{assetId} {
      allow read: if true;   // used on public pages
      allow create: if signedIn() && canManage(request.resource.data.school);
      allow update, delete: if signedIn() && canManage(resource.data.school);
    }

    /* ---- Back office: planning checklist ---- */
    match /planning/{taskId} {
      allow read: if signedIn() && canManage(resource.data.school);
      allow create: if signedIn() && canManage(request.resource.data.school);
      allow update, delete: if signedIn() && canManage(resource.data.school);
    }

    /* ---- Yearbook: event folders (parents read to fill the dropdown) ---- */
    match /yearbook_folders/{id} {
      allow read: if true;
      allow create: if signedIn() && canManage(request.resource.data.school);
      allow update, delete: if signedIn() && canManage(resource.data.school);
    }

    /* ---- Shared PTO calendar ---- */
    match /pto_events/{id} {
      allow read, write: if isAnyAdmin();
    }

    /* ---- Fundraising ---- */
    match /fundraisers/{id} {
      allow read: if signedIn() && canManage(resource.data.school);
      allow create: if signedIn() && canManage(request.resource.data.school);
      allow update, delete: if signedIn() && canManage(resource.data.school);
    }

    /* ---- Planning: idea board ---- */
    match /ideas/{id} {
      allow read: if signedIn() && canManage(resource.data.school);
      allow create: if signedIn() && canManage(request.resource.data.school);
      allow update, delete: if signedIn() && canManage(resource.data.school);
    }

    /* ---- Yearbook: photo submissions (no approval step) ---- */
    match /yearbook_photos/{id} {
      allow read: if signedIn() && canManage(resource.data.school);
      // The public upload form creates these directly.
      allow create: if request.resource.data.status == 'live'
                    && request.resource.data.school in ['woestina','jefferson','middle','high','pto']
                    && request.resource.data.photos.size() <= 12;
      allow update, delete: if signedIn() && canManage(resource.data.school);
    }

    /* ---- Programs & Events cards on each school's public landing page ---- */
    match /program_cards/{id} {
      allow read: if true;
      allow create: if signedIn() && canManage(request.resource.data.school);
      allow update, delete: if signedIn() && canManage(resource.data.school);
    }

    /* ---- Back office: feature roadmap / build tracker (owner-only) ---- */
    match /roadmap_items/{id} {
      allow read, write: if isOwner();
    }

    /* ---- Chocolate Bar Fundraiser: seller pickup requests (public form) ---- */
    match /chocolate_seller_requests/{id} {
      allow read, update, delete: if isAnyAdmin();
      allow create: if request.resource.data.keys().hasOnly(
                        ['parentName','studentName','school','grade','email','phone','quantity','pickup','notes','status','at'])
                    && request.resource.data.parentName is string && request.resource.data.parentName.size() > 0 && request.resource.data.parentName.size() <= 100
                    && request.resource.data.studentName is string && request.resource.data.studentName.size() > 0 && request.resource.data.studentName.size() <= 100
                    && request.resource.data.school in ['Schalmont Middle School', 'Schalmont High School']
                    && request.resource.data.email is string && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 200
                    && request.resource.data.status == 'new';
    }

    /* ---- Public sign-up sheets (volunteer slots, event RSVPs) ---- */
    match /signups/{sid} {
      allow read: if true;                              // public sign-up pages read this
      allow write: if isAnyAdmin();

      match /slots/{slotId} {
        allow read: if true;
        allow create, delete: if isAnyAdmin();
        // A public sign-up bumps ONLY the "taken" counter, never past capacity.
        allow update: if isAnyAdmin() || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['taken'])
          && request.resource.data.taken is int
          && request.resource.data.taken > resource.data.taken
          && request.resource.data.taken <= resource.data.taken + 20
          && (resource.data.capacity == 0 || request.resource.data.taken <= resource.data.capacity)
        );
      }
      // Who signed up — name + count only, publicly visible on the sheet.
      match /entries/{eid} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['slotId','name','count','at'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
          && request.resource.data.count is int
          && request.resource.data.count > 0 && request.resource.data.count <= 20;
        allow update, delete: if isAnyAdmin();
      }
      // Contact details for the organiser only.
      match /contacts/{eid} {
        allow read: if isAnyAdmin();
        allow create: if request.resource.data.keys().hasOnly(['email','phone','comment']);
        allow update, delete: if isAnyAdmin();
      }
    }

    /* ---- Users / roles ---- */
    match /users/{userId} {
      // A person can read their own record; any back-office admin can read the
      // roster (needed to assign planning tasks).
      allow read: if signedIn() && (request.auth.uid == userId || isAnyAdmin());
      allow create: if isOwner() ||
                    (signedIn() && request.auth.uid == userId
                     && request.resource.data.status in ['pending', 'approved']);
      // A person may keep their own directory profile fields up to date, but may
      // NOT give themselves a role. Only the owner changes role / adminSchools.
      allow update: if signedIn() && (
        isOwner() ||
        (request.auth.uid == userId
          && !('role' in request.resource.data.diff(resource.data).affectedKeys())
          && !('adminSchools' in request.resource.data.diff(resource.data).affectedKeys()))
      );
      allow delete: if isOwner();
    }

    /* ---- Existing collections (unchanged) ---- */
    match /raffle_entries/{docId} { allow read, write: if true; }
    match /parking_spot_signups_2027/{docId} { allow read, write: if true; }
    match /massage_signups/{docId} {
      allow read, create, delete: if true;
      allow update: if signedIn() && request.auth.token.email in ['julie@schalmontpto.com'];
    }
    match /events/{eventId} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /directory/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }
  }
}
